<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Exe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>5</LangVersion>
    <DebugType>full</DebugType>
    <DebugSymbols>true</DebugSymbols>
    <Optimize>true</Optimize>
    <UseWPF>true</UseWPF>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <AssemblyName>Application</AssemblyName>
    <DefaultItemExcludes>$(DefaultItemExcludes);.build/**;dist/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="steganography/**/*.cs;tests/**/*.cs" />
    <EmbeddedResource Include=".build/Steganography.sha256" LogicalName="Steganography.sha256" Condition="Exists('.build/Steganography.sha256')" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
    <EmbeddedResource Include="App/MainWindow.xaml" LogicalName="MainWindow.xaml" />
    <EmbeddedResource Include="native/reviewer.ico" LogicalName="Reviewer.ico" />
    <EmbeddedResource Include="native/COPYING.LGPLv2.1" LogicalName="COPYING.LGPLv2.1" />
    <EmbeddedResource Include="native/COPYING.dav1d" LogicalName="COPYING.dav1d" />
    <EmbeddedResource Include="native/COPYING.draft-ai" LogicalName="COPYING.draft-ai" />
    <EmbeddedResource Include="native/COPYING.gemma-runtime" LogicalName="COPYING.gemma-runtime" />
    <EmbeddedResource Include="native/COPYING.sqlite3mc" LogicalName="COPYING.sqlite3mc" />
  </ItemGroup>
</Project>
